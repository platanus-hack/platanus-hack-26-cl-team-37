# Lo normal es recibir un .env.dev ya armado y correr:  node scripts/entorno.mjs dev   (ver docs/equipo/ambientes.md)
# Si no, copia este archivo así:  .env.example  →  .env.local  y  .env.secrets  (ambos ignorados por git).
# Los VALORES se piden por el canal privado del equipo. NUNCA los pegues en un PR, issue o chat público.

# ── .env.local: públicas (viajan en la app) ───────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── .env.secrets: SECRETAS (solo scripts y pruebas; nunca en código del navegador) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Solo quien aplica migraciones (supabase db push):
SUPABASE_DB_PASSWORD=
